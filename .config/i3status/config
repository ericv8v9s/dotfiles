# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
	output_format = "none"
	colors = true
	separator = " | "
	interval = 1
}

order += "wireless wlp7s0"
wireless wlp7s0 {
	format_up = "W: %quality"
	format_down = "W: down"
}

order += "ethernet enp8s0"
ethernet enp8s0 {
	format_up = "E: up"
	format_down = "E: down"
}

#order += "battery all"
#battery all {
#	integer_battery_capacity = true
#	format = "BAT: %percentage"
#}

order += "load"
load {
	format = "%1min %5min %15min"
	max_threshold = 8
}

order += "volume master"
volume master {
	format = "VOL: %volume"
	format_muted = "VOL: (%volume)"
}

order += "tztime alt"
tztime alt {
	format = "---%dT%HZ"
	timezone = "UTC-0"
}

order += "tztime local"
tztime local {
	format = "%Y-%m-%dT%H:%M:%S%z -W%V-%u"
}
